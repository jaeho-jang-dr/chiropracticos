# 환경변수 (anon key는 정의상 public이라 config.js는 commit OK,
# service_role key 같은 비밀은 절대 .env에 두기)
.env
.env.local
.env.*.local

# 로컬/IDE
.vscode/
.idea/
.claude/
*.swp
.DS_Store
Thumbs.db

# 빌드/캐시
node_modules/
.vercel/
.cache/
coverage/

# Serena 프로젝트 메모리 (로컬 코드 인텔리전스)
.serena/

# Drive 동기화 충돌
~$*
*.tmp

# 미디어 — R2에서 호스팅, GitHub에는 트래킹 안 함
**/*.mp4
**/*.m4a
**/*.mp3
**/*.wav
**/*.pdf
**/*.pptx
**/*.docx
**/*.zip
# 예외: credentials/ 의 자격증 PDF는 작은 파일이며 의도적 트래킹
!archive/credentials/*.pdf

# 미사용 참고도서 표지 이미지 — HTML 참조 0, 39MB. 통합 시 untrack 해제 또는 R2 이전
images/chapter1/references/

.vercel
tmp_fn_podcasts/

# 임시 자동화 스크립트 (G 마스터에 보존, repo에는 트래킹 안 함)
tmp_*.py

# 테스트 실행 로그 (transient)
test_*.log
test_baseline.log
test_after_*.log
test_round*.log
test_final.log

# 팟캐스트 임시 및 상태 파일
*_status.json
regeneration_queue.json
create_output.txt
extracted_prompts.txt
status_analysis.txt
nlm_status*.json
downloads/

tmp_fn_podcasts/
korean_restore/

