# 환경변수 (anon key는 정의상 public이라 config.js는 commit OK,
# service_role key 같은 비밀은 절대 .env에 두기)
.env
.env.local
.env.*.local

# 로컬/IDE
.vscode/
.idea/
.claude/
*.swp
.DS_Store
Thumbs.db

# 빌드/캐시
node_modules/
.vercel/
.cache/

# Drive 동기화 충돌
~$*
*.tmp

# 미디어 — R2에서 호스팅, GitHub에는 트래킹 안 함
**/*.mp4
**/*.m4a
**/*.mp3
**/*.wav
**/*.pdf
**/*.pptx
**/*.docx
**/*.zip
# 예외: credentials/ 의 자격증 PDF는 작은 파일이며 의도적 트래킹
!archive/credentials/*.pdf

.vercel
tmp_fn_podcasts/
