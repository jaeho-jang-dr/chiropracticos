# ===========================================================================
# .env.example — 실제 값은 .env 에 (gitignored)
# ===========================================================================
# 새 환경에서 복제하려면:
#   cp .env.example .env
#   # 그 다음 .env 의 각 값 채우기
# ===========================================================================

# Vercel — https://vercel.com/account/tokens
VERCEL_TOKEN=vcp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VERCEL_SCOPE=team_xxxxx_or_personal_username
VERCEL_PROJECT_ALIAS=your-app.vercel.app

# Supabase Management — https://supabase.com/dashboard/account/tokens
SUPABASE_PAT=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx

# Supabase DB direct (project create 시 설정한 비번)
SUPABASE_DB_PASSWORD=xxxxxxxxxx

# Google OAuth — https://console.cloud.google.com/auth/clients
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# GitHub repo
GITHUB_REPO_URL=https://github.com/<owner>/<repo>.git
